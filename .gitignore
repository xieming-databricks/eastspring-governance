# Virtual environments (rebuild from requirements.txt)
.venv/
venv/
env/

# Python bytecode / caches
__pycache__/
*.py[cod]
*$py.class

# Test / tooling caches
.pytest_cache/
.mypy_cache/
.ruff_cache/
.coverage
htmlcov/

# Packaging / build artifacts
*.egg-info/
build/
dist/

# Editor / OS cruft
.DS_Store
# Office lock files (a workbook open in Excel)
~$*
.idea/
.vscode/
*.swp

# Local scratch
*.tmp
*.bak
*~

# Local tooling / scratch folders
.isaac/
.claude/
.databricks/
aux_files/

# Local-only working files (test references, scratch, moved-out copies) — never committed
local/
