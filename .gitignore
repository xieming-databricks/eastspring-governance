# Virtual environments (rebuild from requirements.txt)
.venv/
venv/
env/

# Python bytecode / caches
__pycache__/
*.py[cod]
*$py.class

# Test / tooling caches
.pytest_cache/
.mypy_cache/
.ruff_cache/
.coverage
htmlcov/

# Packaging / build artifacts
*.egg-info/
build/
dist/

# Editor / OS cruft
.DS_Store
.idea/
.vscode/
*.swp

# Local scratch
*.tmp
*.bak
*~

# Terraform (init cache, state, crash logs, tfvars). NOTE: .terraform.lock.hcl is intentionally
# NOT ignored — commit it to pin provider versions/hashes for reproducible `terraform init`.
**/.terraform/
*.tfstate
*.tfstate.*
crash.log
crash.*.log
*.tfvars
*.tfvars.json
override.tf
override.tf.json
*_override.tf
*_override.tf.json
.terraformrc
terraform.rc


.isaac/

aux_files/
