{
  "name": "ucgov-reconcile",
  "description": "Full-sync the reference's target_catalog against the YAML config (notebooks/reconcile.py). mode=plan changes nothing. Managed by azure-pipelines.yml - edits in the UI are overwritten on the next deploy.",
  "max_concurrent_runs": 1,
  "queue": { "enabled": true },
  "parameters": [
    { "name": "config_path",    "default": "" },
    { "name": "reference_path", "default": "" },
    { "name": "mode",           "default": "plan" }
  ],
  "tasks": [
    {
      "task_key": "reconcile",
      "notebook_task": {
        "notebook_path": "__NOTEBOOK_FOLDER__/reconcile",
        "source": "WORKSPACE"
      },
      "environment_key": "ucgov"
    }
  ],
  "environments": [
    {
      "environment_key": "ucgov",
      "spec": {
        "environment_version": "3",
        "dependencies": ["__WHEEL_PATH__"]
      }
    }
  ],
  "tags": { "app": "eastspring-uc-governance", "managed_by": "azure-pipelines" }
}
