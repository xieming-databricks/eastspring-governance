{
  "name": "ucgov-apply-functions",
  "description": "CREATE OR REPLACE the env's mask UDFs + group_portfolio_access MV from sql_path (notebooks/apply_functions.py). mode=plan changes nothing. Managed by azure-pipelines.yml - edits in the UI are overwritten on the next deploy.",
  "max_concurrent_runs": 1,
  "queue": { "enabled": true },
  "parameters": [
    { "name": "reference_path", "default": "" },
    { "name": "sql_path",       "default": "" },
    { "name": "mode",           "default": "plan" }
  ],
  "tasks": [
    {
      "task_key": "apply_functions",
      "notebook_task": {
        "notebook_path": "__NOTEBOOK_FOLDER__/apply_functions",
        "source": "WORKSPACE"
      },
      "environment_key": "ucgov"
    }
  ],
  "environments": [
    {
      "environment_key": "ucgov",
      "spec": {
        "environment_version": "3",
        "dependencies": ["__WHEEL_PATH__"]
      }
    }
  ],
  "tags": { "app": "eastspring-uc-governance", "managed_by": "azure-pipelines" }
}
